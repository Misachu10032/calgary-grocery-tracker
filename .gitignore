# Secrets: never commit
.env
.env.*
!.env.example

# Local price database: stays on this computer (only web/data/site-data.json is published).
# Back it up yourself; it holds the full price history.
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# Weekly job logs (scripts/run_weekly.cmd)
/logs/

# Python
__pycache__/
*.pyc
.venv/

# Node / website
node_modules/
.next/
.vercel/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
