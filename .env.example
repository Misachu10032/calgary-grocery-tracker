# Template only: copy this file to .env and put real values there.
# .env is git-ignored; this file is NOT, so never put real keys or passwords here.

# Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API Keys → Publishable key (sb_publishable_...), safe for the website, read-only.
# Older projects: the legacy "anon" key works here too.
SUPABASE_ANON_KEY=

# Project Settings → API Keys → Secret key (sb_secret_...), local script only: full write access.
# Older projects: the legacy "service_role" key works here too.
SUPABASE_SERVICE_ROLE_KEY=

# Connect button (top of dashboard) → Session pooler → URI, with your database password filled in.
# Use the Session pooler, not "Direct connection": direct is IPv6-only on the free plan.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
